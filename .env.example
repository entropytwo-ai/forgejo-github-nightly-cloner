# Copy to .env and replace every placeholder. NEVER commit .env.
# Generate random secrets with e.g.:  openssl rand -hex 32

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=forgejo

# --- Forgejo -------------------------------------------------------------------
# Initial admin account (created with `forgejo admin user create`, see README).
FORGEJO_ADMIN_USER=forgejo-admin
FORGEJO_ADMIN_PASSWORD=change-me-strong-admin-password
FORGEJO_ADMIN_EMAIL=admin@example.com
# Secret used to encrypt data such as stored mirror credentials: openssl rand -hex 32
FORGEJO_SECRET_KEY=change-me-random-64-hex-chars
# Internal token: docker run --rm codeberg.org/forgejo/forgejo:10 forgejo generate secret INTERNAL_TOKEN
FORGEJO_INTERNAL_TOKEN=change-me-internal-token
# Public URL/domain of the Forgejo web UI (behind your reverse proxy).
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3000/
# Host ports (bound to 127.0.0.1 only).
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# --- Worker ------------------------------------------------------------------
# URL the worker uses to reach Forgejo inside the compose network.
FORGEJO_URL=http://forgejo:3000
# Forgejo API token for the worker (create after first start, see README).
FORGEJO_TOKEN=change-me-forgejo-api-token
# Optional: override forgejo.owner from config.yml.
FORGEJO_OWNER=
# GitHub personal access token. Classic: scopes `repo` + `read:org`.
# Fine-grained: Contents, Issues, Pull requests, Metadata = read-only.
GITHUB_TOKEN=change-me-github-token
# Days to keep metadata backups (at least 2 are always kept).
BACKUP_RETENTION_DAYS=30
# Cron expression for the nightly sync (container time zone, see TZ).
SYNC_SCHEDULE=0 2 * * *
TZ=UTC
# true = log what would happen without changing anything.
DRY_RUN=false
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
